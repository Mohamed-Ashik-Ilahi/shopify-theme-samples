{{ 'product-bundle.css' | asset_url | stylesheet_tag }}

<div class="product-bundle" id="bundle-{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <h2 class="product-bundle__heading">{{ section.settings.heading }}</h2>
  {%- endif -%}

  {%- if section.settings.subheading != blank -%}
    <p class="product-bundle__subheading">{{ section.settings.subheading }}</p>
  {%- endif -%}

  <form class="product-bundle__form" data-bundle-form>
    <ul class="product-bundle__list">
      {%- for block in section.blocks -%}
        {%- assign bundle_product = block.settings.product -%}
        {%- if bundle_product != blank -%}
          <li class="product-bundle__item" {{ block.shopify_attributes }}>
            <label class="product-bundle__label">
              <input
                type="checkbox"
                name="bundle_item"
                value="{{ bundle_product.selected_or_first_available_variant.id }}"
                data-price="{{ bundle_product.selected_or_first_available_variant.price }}"
                {% if block.settings.checked_by_default %}checked{% endif %}
              >
              <span class="product-bundle__item-image">
                {{ bundle_product.featured_image | image_url: width: 200 | image_tag }}
              </span>
              <span class="product-bundle__item-details">
                <span class="product-bundle__item-title">{{ bundle_product.title }}</span>
                <span class="product-bundle__item-price">
                  {{ bundle_product.selected_or_first_available_variant.price | money }}
                </span>
              </span>
            </label>
          </li>
        {%- endif -%}
      {%- endfor -%}
    </ul>

    <div class="product-bundle__summary">
      <span class="product-bundle__total-label">Bundle total:</span>
      <span class="product-bundle__total-value" data-bundle-total>{{ 0 | money }}</span>
      {%- if section.settings.discount_percent > 0 -%}
        <span class="product-bundle__discount-badge">
          Save {{ section.settings.discount_percent }}%
        </span>
      {%- endif -%}
    </div>

    <button type="submit" class="product-bundle__submit button" data-bundle-submit disabled>
      {{ section.settings.button_label | default: 'Add bundle to cart' }}
    </button>
  </form>
</div>

<script src="{{ 'product-bundle.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product bundle",
  "tag": "section",
  "class": "section-product-bundle",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Build your wellness bundle"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Mix and match to save on your favorites"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Add bundle to cart"
    },
    {
      "type": "range",
      "id": "discount_percent",
      "label": "Bundle discount",
      "min": 0,
      "max": 50,
      "step": 5,
      "unit": "%",
      "default": 10
    }
  ],
  "blocks": [
    {
      "type": "bundle_item",
      "name": "Bundle item",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "checkbox",
          "id": "checked_by_default",
          "label": "Selected by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product bundle",
      "blocks": [
        { "type": "bundle_item" },
        { "type": "bundle_item" },
        { "type": "bundle_item" }
      ]
    }
  ]
}
{% endschema %}
